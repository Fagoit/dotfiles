# Dotfiles WindowMaker keybindings.

"ghostty"
  Mod4 + q

"librewolf"
  Mod4 + b

"nautilus --new-window"
  Mod4 + e

"rofi -show drun"
  Mod4 + r

"rofi -show run"
  Mod4 + Alt + space

"i3lock -c 000000"
  Mod4 + Escape

# Toggle fullscreen on the active window (rescues apps like Telegram that
# launch fullscreen with no titlebar). Falls back to un-maximize via xdotool.
"wmctrl -r :ACTIVE: -b toggle,fullscreen 2>/dev/null || xdotool getactivewindow windowsize 60% 60% windowmove --relative -- 0 0"
  Mod4 + f

"bash \"$HOME/.local/share/dotfiles/bin/x-screenshot\" area-clip"
  Mod4 + Shift + s

"bash \"$HOME/.local/share/dotfiles/bin/x-screenshot\" area-file"
  Print

"pamixer -i 5 && notify-send \"Volume\" \"$(pamixer --get-volume)%\""
  XF86AudioRaiseVolume

"pamixer -d 5 && notify-send \"Volume\" \"$(pamixer --get-volume)%\""
  XF86AudioLowerVolume

"pamixer -t && notify-send \"Volume\" \"Mute toggled\""
  XF86AudioMute

"playerctl play-pause"
  XF86AudioPlay

"playerctl play-pause"
  XF86AudioPause

"playerctl next"
  XF86AudioNext

"playerctl previous"
  XF86AudioPrev

"brightnessctl set +5% && notify-send \"Brightness\" \"$(brightnessctl get)\""
  XF86MonBrightnessUp

"brightnessctl set 5%- && notify-send \"Brightness\" \"$(brightnessctl get)\""
  XF86MonBrightnessDown
