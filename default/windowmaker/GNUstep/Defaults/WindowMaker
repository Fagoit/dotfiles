  AntialiasedText = YES;
  WindowTitleFont = "Trebuchet MS,sans serif:weight=200:pixelsize=12";
  MenuTitleFont = "Trebuchet MS,sans serif:bold:pixelsize=12";
  MenuTextFont = "Trebuchet MS,sans serif:pixelsize=12";
  IconTitleFont = "Arial,sans serif:pixelsize=9";
  ClipTitleFont = "Verdana:bold:pixelsize=10";
  LargeDisplayFont = "Trebuchet MS,sans serif:pixelsize=24";

  FTitleColor = "#666666";
  FTitleBack = (hgradient, white, "#c79bff");
  PTitleColor = "#bebebe";
  PTitleBack = (hgradient, "#c79bff", "#a96bff");
  UTitleColor = "#cbb8e6";
  UTitleBack = (hgradient, "#9d5cff", "#5b2a86");
  ResizebarBack = (hgradient, "#9d5cff", "#5b2a86");

  MenuStyle = normal;
  MenuTitleColor = "#ffffff";
  MenuTitleBack = (hgradient, "#c79bff", "#5b2a86");
  MenuTextColor = "#ffffff";
  MenuTextBack = (hgradient, "#5b2a86", black);
  MenuDisabledColor = "#9a8fb0";

  IconBack = (dgradient, "#7e5aa8", "#e8d6ff");
  IconTitleBack = "#ece0ff";
  IconTitleColor = "#5b2a86";
  ClipTitleColor = "#ffffff";
  CClipTitleColor = "#333333";

  HighlightColor = "#ffffff";
  HighlightTextColor = "#000000";
  FrameBorderWidth = 1;
  FrameBorderColor = "#b6b6b3";
  FrameFocusedBorderColor = "#a96bff";
  FrameSelectedBorderColor = "#ffffff";

  WorkspaceBack = (mdgradient, black, black, black, "#1a1030");

