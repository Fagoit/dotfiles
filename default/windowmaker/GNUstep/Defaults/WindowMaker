{
  IconSize = 64;
  WorkspaceNameDisplayPosition = center;
  WorkspaceCount = 4;
  WorkspaceNames = ("Main", "Web", "Files", "Media");
  DisableDock = NO;
  DisableClip = NO;
  ColormapMode = auto;

  ModifierKey = "Mod4";

  CloseKey = "Mod4+w";
  MiniaturizeKey = "Mod4+n";
  HideKey = "Mod4+h";
  MoveResizeKey = "Mod4+m";
  MaximizeKey = "Mod4+Up";
  VMaximizeKey = "Mod4+Shift+Up";
  HMaximizeKey = "Mod4+Shift+Down";
  ShadeKey = "Mod4+s";
  FocusNextKey = "Mod4+Tab";
  FocusPrevKey = "Mod4+Shift+Tab";
  WindowListKey = "Mod4+grave";
  WindowMenuKey = "Mod4+space";

  NextWorkspaceKey = "Mod4+Right";
  PrevWorkspaceKey = "Mod4+Left";
  Workspace1Key = "Mod4+1";
  Workspace2Key = "Mod4+2";
  Workspace3Key = "Mod4+3";
  Workspace4Key = "Mod4+4";
  MoveToWorkspace1Key = "Mod4+Shift+1";
  MoveToWorkspace2Key = "Mod4+Shift+2";
  MoveToWorkspace3Key = "Mod4+Shift+3";
  MoveToWorkspace4Key = "Mod4+Shift+4";

  /* ---- Purple rice (ported from Roel-6 "Cutie patootie", pink -> purple) ---- */
