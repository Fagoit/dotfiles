#!/bin/bash

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "$SCRIPT_DIR/lib/helpers.sh"
source "$SCRIPT_DIR/lib/backup.sh"
DOTFILES_DIR="$HOME/.local/share/dotfiles"
HYPRLAND_CONF="$HOME/.config/hypr/hyprland.lua"

log_info "Configuring hardware-specific settings..."

# Determine which environment and keybindings to use
HARDWARE=$(detect_hardware_type)
if has_nvidia_gpu; then
  HARDWARE="nvidia"
  log_detail "Detected NVIDIA GPU"
fi
IS_LAPTOP=false
if [ "$HARDWARE" = "laptop" ]; then
  IS_LAPTOP=true
fi

if [ "$IS_LAPTOP" = true ]; then
  systemctl --user enable --now hypridle.service 2>/dev/null && log_detail "Enabled hypridle service" || true
  log_detail "Detected laptop hardware"
else
  spinner "Installing ddcutil..." yay --noconfirm -S ddcutil
  log_detail "Detected desktop hardware"
fi

# Persist hardware selection for the Lua configuration.
mkdir -p "$HOME/.config/hypr"
if [ "$IS_LAPTOP" = true ]; then
  printf '%s\n' "laptop" > "$HOME/.config/hypr/hardware"
elif [ "$HARDWARE" = "nvidia" ]; then
  printf '%s\n' "nvidia" > "$HOME/.config/hypr/hardware"
else
  printf '%s\n' "desktop" > "$HOME/.config/hypr/hardware"
fi

log_success "Hardware-specific configuration applied"

# Auto-configure monitors if Hyprland is running
if command -v hyprctl &>/dev/null && hyprctl monitors &>/dev/null; then
  log_info "Detecting monitor configuration..."

  MONITORS_CONF="$HOME/.config/hypr/conf/monitors.lua"
  TEMP_CONF=$(mktemp)

  echo "return {" > "$TEMP_CONF"

  # Parse hyprctl output and extract highest mode for each monitor
  hyprctl monitors | awk '
    /^Monitor / {
      if (monitor) print "\t{ output = \"" monitor "\", mode = \"" mode "\", position = \"auto\", scale = 1 },"
      monitor = $2
      gsub(/[()]/, "", monitor)
      mode = ""
      max_refresh = 0
    }
    /availableModes:/ {
      in_modes = 1
      modes_line = $0
      sub(/.*availableModes: /, "", modes_line)

      split(modes_line, modes, " ")
      for (i in modes) {
        if (modes[i] ~ /@/) {
          split(modes[i], parts, "@")
          res = parts[1]
          refresh = parts[2]
          sub(/Hz$/, "", refresh)

          if (refresh + 0 > max_refresh) {
            max_refresh = refresh + 0
            mode = modes[i]
            sub(/Hz$/, "", mode)
          }
        }
      }
    }
    END {
      if (monitor && mode) print "\t{ output = \"" monitor "\", mode = \"" mode "\", position = \"auto\", scale = 1 },"
    }
  ' >> "$TEMP_CONF"

  # Only update if we got valid output
  echo "}" >> "$TEMP_CONF"
  if grep -q "output =" "$TEMP_CONF"; then
    mv "$TEMP_CONF" "$MONITORS_CONF"
    log_success "Auto-configured monitor"
  else
    rm -f "$TEMP_CONF"
    log_detail "Could not detect monitor resolution, keeping default config"
  fi
else
  log_detail "Hyprland not running, keeping default monitor config"
fi
