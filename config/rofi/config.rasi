configuration {
    modi:                "drun,run,window";
    case-sensitive:      false;
    cycle:               true;
    show-icons:          true;
    icon-theme:          "Papirus";
    drun-display-format: "{name}";
    drun-match-fields:   "name,generic,exec,categories,keywords";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    font:                "CaskaydiaMono Nerd Font 12";
    terminal:            "ghostty";
    click-to-exit:       true;
}

@import "theme.rasi"
