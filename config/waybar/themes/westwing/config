{
    "layer": "top",
    "position": "left",
    "width": 48,
    "exclusive": true,
    "include": [
        "~/.config/waybar/modules.json"
    ],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H\n%M}",
        "format-alt": "{:%d\n%m}",
        "tooltip-format": "{:%A %d %B}",
        "tooltip": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    },

    "modules-left": [
        "hyprland/workspaces",
        "custom/updates"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "bluetooth",
        "cpu",
        "battery",
        "tray",
        "custom/exit"
    ]
}
