{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "fixed-center": true,
    "spacing": 8,
    "margin-top": 8,
    "margin-left": 72,
    "margin-right": 72,
    "include": [
        "~/.config/waybar/modules.json"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "default": "○",
            "active": "●",
            "urgent": "!"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%A  ·  %H:%M}",
        "format-alt": "{:%d %B %Y}",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "modules-left": [
        "hyprland/workspaces",
        "custom/updates",
        "tray"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/music",
        "pulseaudio",
        "network",
        "bluetooth",
        "cpu",
        "battery",
        "custom/exit"
    ]
}
