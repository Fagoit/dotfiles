#!/bin/bash
# Session launcher for the WindowMaker (dotfiles) X session.
# Intentionally does NOT use `set -e`: a single optional helper failing
# (keyring, wallpaper, picom, ...) must never prevent `wmaker` from starting.

DOTFILES_DIR="$HOME/.local/share/dotfiles"
export PATH="$DOTFILES_DIR/bin:$HOME/.local/bin:$PATH"
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=WindowMaker
export DESKTOP_SESSION=windowmaker
# Force GTK apps to use server-side (WindowMaker) decorations instead of drawing
# their own client-side header bars. Affects GTK3 apps; GTK4/libadwaita apps that
# ignore this are pinned via WMWindowAttributes (IgnoreDecorationChanges).
export GTK_CSD=0

systemctl --user import-environment PATH DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP DESKTOP_SESSION 2>/dev/null || true
systemctl --user start graphical-session.target 2>/dev/null || true

/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 2>/dev/null &
bash "$DOTFILES_DIR/bin/check-windowmaker-session" 2>/dev/null || true

if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null || true)"
  export SSH_AUTH_SOCK
fi

if command -v xset >/dev/null 2>&1; then
  xset s on || true
  xset s 600 60 || true
  xset dpms 900 1200 1800 || true
  # Snappier keyboard repeat + mouse acceleration (stolen from Roel's autostart).
  xset r rate 200 35 || true
  xset m 20/10 4 || true
fi

# Warm/dim gamma curve (Roel's calibration).
if command -v xgamma >/dev/null 2>&1; then
  xgamma -rgamma 1 -ggamma 0.9 -bgamma 0.55 || true
fi

# Boost color saturation on every connected output (Roel used vibrant-cli on a
# single hardcoded LVDS-1; we apply it to whatever monitors are actually present).
if command -v vibrant-cli >/dev/null 2>&1 && command -v xrandr >/dev/null 2>&1; then
  for out in $(xrandr --query | awk '/ connected/{print $1}'); do
    vibrant-cli "$out" 1.3 2>/dev/null || true
  done
fi

bash "$DOTFILES_DIR/bin/x-monitors" 2>/dev/null || true

# Apply the wallpaper AFTER wmaker has come up. wmaker repaints the root
# window on startup (covering feh), and the animated (xwinwrap) wallpaper
# needs the WM running so it can be stacked below everything else.
(sleep 2; bash "$DOTFILES_DIR/bin/x-wallpaper") >/dev/null 2>&1 &

# Launch dock applications once WindowMaker's Dock exists.
(sleep 3; bash "$DOTFILES_DIR/bin/x-dockapps") >/dev/null 2>&1 &

if command -v xbindkeys >/dev/null 2>&1 && [ -f "$HOME/.xbindkeysrc" ]; then
  xbindkeys || true
fi

# Restore the last pywal palette (rofi/dunst/picom shadow) before picom starts,
# so colors are in place immediately. x-wallpaper regenerates them from the
# wallpaper a couple seconds later.
if command -v wal >/dev/null 2>&1; then
  wal -R -n -q -e -o "$DOTFILES_DIR/bin/walrefresh" >/dev/null 2>&1 || true
fi

if command -v picom >/dev/null 2>&1; then
  picom --daemon || true
fi

# Freeze the animated wallpaper while a fullscreen game/video is focused, to
# free GPU + VRAM (the wallpaper isn't visible behind a fullscreen app anyway).
if command -v xprop >/dev/null 2>&1; then
  setsid -f "$DOTFILES_DIR/bin/x-gamemode" watch >/dev/null 2>&1 || true
fi

if command -v xss-lock >/dev/null 2>&1; then
  xss-lock -- i3lock -c 000000 &
fi

exec wmaker
