#!/bin/bash
set -e

choice=$(printf '%s\n' \
  "Area to clipboard" \
  "Area to file" \
  "Fullscreen to clipboard" \
  "Fullscreen to file" | rofi -dmenu -p "Screenshot")

SHOT="$(dirname "$(readlink -f "$0")")/x-screenshot"

case "$choice" in
  "Area to clipboard")      bash "$SHOT" area-clip ;;
  "Area to file")           bash "$SHOT" area-file ;;
  "Fullscreen to clipboard") bash "$SHOT" full-clip ;;
  "Fullscreen to file")     bash "$SHOT" full-file ;;
esac
